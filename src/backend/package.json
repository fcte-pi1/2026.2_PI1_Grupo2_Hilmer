{
  "name": "backend_microMouse",
  "version": "1.0.0",
  "description": "Backend em NestJS para telemetria em tempo real, persistência e controle do robô resolvedor de labirinto via WebSockets e PostgreSQL.",
  "author": "Grupo02",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcte-pi1/2026.2_PI1_Grupo2_Hilmer.git"
  },
  "bugs": {
    "url": "https://github.com/fcte-pi1/2026.2_PI1_Grupo2_Hilmer/issues"
  },
  "homepage": "https://github.com/fcte-pi1/2026.2_PI1_Grupo2_Hilmer#readme",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "dev": "npm run dev:setup",
    "dev:setup": "npm run services:up && npm run services:wait:database && npm run db:migrate && npm run db:seed",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "db:studio:dev": "dotenv -e .env.development -- prisma studio",
    "db:studio:test": "dotenv -e .env.test -- prisma studio --port 5556",
    "ingest:dev": "ts-node src/dev-ingest.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "pretest:int": "npm run services:up && npm run services:wait:database && dotenv -e .env.test -- node infra/scripts/create-test-db.js && dotenv -e .env.test -- prisma db push --skip-generate",
    "test:int": "dotenv -e .env.test -- jest --config ./tests/jest-integration.json --runInBand --verbose",
    "test:int:watch": "dotenv -e .env.test -- jest --config ./tests/jest-integration.json --watchAll --runInBand --verbose"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^6.4.1",
    "async-retry": "^1.3.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.9",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "shell-quote": "^1.8.2",
    "deepmerge-ts": "^8.0.0"
  }
}
