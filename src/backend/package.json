{
  "name": "backend_rato",
  "version": "1.0.0",
  "description": "Backend em NestJS para telemetria em tempo real, persistência e controle do robô resolvedor de labirinto via WebSockets e PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run db:migrate && npm run db:seed && npm run db:studio",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "test": "jest --runInBand --verbose",
    "test:watch": "jest --watchAll --runInBand --verbose"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcte-pi1/2026.2_PI1_Grupo2_Hilmer.git"
  },
  "author": "Grupo02",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fcte-pi1/2026.2_PI1_Grupo2_Hilmer/issues"
  },
  "homepage": "https://github.com/fcte-pi1/2026.2_PI1_Grupo2_Hilmer#readme",
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@prisma/client": "^6.4.1",
    "async-retry": "^1.3.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "shell-quote": "^1.8.2",
    "deepmerge-ts": "^8.0.0"
  }
}
