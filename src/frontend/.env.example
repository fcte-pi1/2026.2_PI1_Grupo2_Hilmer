# Endereço da API REST do backend usado nas buscas feitas no servidor do Next
# (páginas renderizadas no servidor, como /historico). No Docker: http://backend:3002
API_URL=http://localhost:3002

# Endereço da API usado nas buscas feitas no navegador. Precisa do prefixo
# NEXT_PUBLIC_ para ser lido no navegador
NEXT_PUBLIC_API_URL=http://localhost:3002

# true: histórico usa os dados de src/lib/mock-corridas.ts (sem backend)
# false: busca em GET ${API_URL}/runs e GET ${API_URL}/runs/best
NEXT_PUBLIC_USE_MOCK=false

# WebSocket da telemetria ao vivo (dashboard e cabeçalho). Sem ela, o navegador
# usa o mesmo host da página na porta 3002: ws://<host>:3002/live
# NEXT_PUBLIC_LIVE_URL=ws://localhost:3002/live
