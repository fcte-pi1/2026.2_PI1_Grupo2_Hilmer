# Endereço da API. Precisa do prefixo NEXT_PUBLIC_ para ser lido no navegador
NEXT_PUBLIC_API_URL=http://localhost:3001
# true: histórico usa os dados de src/lib/mock-corridas.ts
# false: busca em GET ${NEXT_PUBLIC_API_URL}/corridas
NEXT_PUBLIC_USE_MOCK=true

# Fonte da telemetria do mapa em tempo real
# simulated: corrida gerada no navegador (não precisa de backend)
# socket: escuta o Socket.IO de NEXT_PUBLIC_API_URL (eventos "telemetry" e "event")
NEXT_PUBLIC_TELEMETRY_SOURCE=simulated
